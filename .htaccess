# START MultiPHP Version
<FilesMatch "\.(php4|php5|php3|php2|php|phtml)$">
    SetHandler application/x-httpd-alt-php84___lsphp
</FilesMatch>
# END MultiPHP Version

# Disable directory listing
Options -Indexes +FollowSymLinks

DirectoryIndex index.php

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home1/bumibara/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home1/bumibara/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block access to hidden files (except .well-known for SSL certificates)
    RewriteRule ^\.(?!well-known).*$ - [NC,F]

    # Block direct access to internal framework folders and files
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|tests|vendor)(/.*)?$ - [NC,F]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|boost\.json|.*\.sql)$ - [NC,F]

    # Forward storage requests to public/storage
    RewriteRule ^storage(/.*)?$ public/storage$1 [L]

    # Forward other static assets from public/ if they exist
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all other requests to front controller index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
